{
  "expo": {
    "name": "KshanaAPI",
    "slug": "kshana-api",
    "version": "1.0.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.kshanaapi.crm"
    },
    "android": {
      "package": "com.kshanaapi.crm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-only.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "scheme": "kshanaapi",
    "plugins": [
      "expo-asset"
    ]
  }
}
