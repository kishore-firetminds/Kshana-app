{
  "expo": {
    "name": "KshanaAPI",
    "slug": "kshana-api",
    "version": "1.1.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.firetminds.kshanaapi",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.firetminds.kshanaapi",
      "versionCode": 6,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "scheme": "kshanaapi",
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#00856A",
          "defaultChannel": "workspace"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to attach to a workspace conversation.",
          "cameraPermission": "Take a photo to attach to a workspace conversation.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F7FBF9"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4ba8cbd-001c-4fc7-a452-91f176931d53"
      }
    },
    "owner": "kishore15421"
  }
}
